"""Example tests the plugin runs (``testo run --cycle unit``), and a check of the plugin itself."""

import unittest


class ExampleTest(unittest.TestCase):
    def test_add(self) -> None:
        self.assertEqual(1 + 1, 2)

    def test_plugin_loads(self) -> None:
        # After `pip install -e .`: both entry points load and pass testo's checks.
        from testo_core import plugins

        plugins.clear_cache()
        if "__NAME__" not in plugins.framework_names():
            self.skipTest("not installed yet: pip install -e .")
        self.assertEqual(plugins.load_framework("__NAME__").results_subdir(), "__NAME__")
        self.assertEqual(plugins.load_reporter("__NAME__-summary")(options={}).reporter_type, "__NAME__-summary")
