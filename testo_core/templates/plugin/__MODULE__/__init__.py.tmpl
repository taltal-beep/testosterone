"""Testosterone plugin __DIST__.

- ``__CLASS__Adapter`` (``equipment: __NAME__``) runs the tests. It starts with
  the standard library's unittest (``runner.py``); point ``build_argv`` at your
  own runner, which only has to write one Allure ``*-result.json`` per test into
  ``results_dir``.
- ``__CLASS__SummaryReporter`` (``reporters: [{type: __NAME__-summary}]``)
  writes the cycle's counts to ``<out_dir>/summary.json`` after every run.

Interface: https://taltal-beep.github.io/testosterone/docs/cli-commands/command-reference/#plugins
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

from testo_core.frameworks.base import NativeReport
from testo_core.reporting.allure_results import parse_collected_results
from testo_core.reporting.reporters.base import BaseReporter, ReporterResult


class __CLASS__Adapter:
    name = "__NAME__"

    def results_subdir(self) -> str:
        return "__NAME__"

    def build_argv(
        self,
        *,
        target_repo: Path,
        results_dir: Path,
        stage_args: tuple[str, ...],
        workers: int,
    ) -> list[str]:
        # The command runs with target_repo as its working directory.
        del target_repo, workers
        return [sys.executable, "-m", "__MODULE__.runner", str(results_dir), *stage_args]

    def native_report(self, stage_dir: Path) -> NativeReport | None:
        del stage_dir
        return None


class __CLASS__SummaryReporter(BaseReporter):
    @property
    def reporter_type(self) -> str:
        return "__NAME__-summary"

    def publish(self, *, results, context, console=None) -> ReporterResult:  # noqa: ANN001
        totals = parse_collected_results(results)
        out = Path(self._options.get("out_dir", "reports")) / "summary.json"
        out.parent.mkdir(parents=True, exist_ok=True)
        payload = {
            "cycle": context.plan_name,
            "run_id": context.run_id,
            "total": totals.total,
            "passed": totals.passed,
            "failed": totals.failed,
            "skipped": totals.skipped,
        }
        out.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
        return ReporterResult(ok=True, message=f"__NAME__-summary: wrote {out}", artifacts=(out,))
