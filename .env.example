# Testosterone — copy to `.env` and fill in values.
# Never commit `.env` (see `.gitignore`).

# --- Streamlit (optional overrides) ---
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost

# --- InfluxDB 2.x (Grafana / time-series) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=testo
INFLUXDB_TOKEN=your-influxdb-api-token

# --- Prometheus Pushgateway ---
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091
PROMETHEUS_JOB_NAME=testo

# --- Run history database (SQLModel / SQLAlchemy) ---
# If DATABASE_URL is set, it is the only connection string used (recommended).
# Otherwise, if POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB are all non-empty,
# testo builds postgresql+psycopg://... from those vars (legacy docker-compose style).
# If neither applies, the default is file-backed SQLite: sqlite:///./testo_history.db
#
# DATABASE_URL=sqlite:///./testo_history.db
# DATABASE_URL=postgresql+psycopg://testo_admin:admin@localhost:5432/testo_history
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/testo_history

# --- Postgres (run history DB; used when DATABASE_URL is unset and all three are set) ---
# POSTGRES_USER=testo_admin
# POSTGRES_PASSWORD=admin
# POSTGRES_DB=testo_history
# POSTGRES_HOST=localhost

# --- InfluxDB integration (optional legacy naming) ---
# INFLUXDB_MEASUREMENT=testo_test_run
