# Testosterone runner service: starts each stage of a team server run in a
# fresh, throwaway container (TESTO_RUNNER=container on the server).
# It is the only container that talks to Docker; the API never gets the socket.
# Run it with deploy/server/docker-compose.runner.yml.

FROM docker:29-cli AS docker-cli

FROM python:3.13-slim-trixie AS runtime

ARG TESTO_VERSION=dev
ARG TESTO_COMMIT_SHA=unknown
ARG TESTO_CREATED=unknown

LABEL org.opencontainers.image.title="testo-runner-service" \
      org.opencontainers.image.description="Starts each Testosterone stage in a throwaway container." \
      org.opencontainers.image.version="${TESTO_VERSION}" \
      org.opencontainers.image.revision="${TESTO_COMMIT_SHA}" \
      org.opencontainers.image.created="${TESTO_CREATED}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Only the docker client: the daemon is the host's (or a rootless one via DOCKER_HOST).
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
# The service is one standard-library file; no packages to install.
COPY testo_core/engine/backends/runner_service.py /app/runner_service.py

RUN useradd --create-home --uid 10001 testo
# Reaching the Docker socket takes its group: compose adds it with `group_add`.
USER testo
WORKDIR /app
EXPOSE 8790
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8790/health', timeout=4)"

ENTRYPOINT ["python", "/app/runner_service.py"]
